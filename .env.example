# ---- Geral
NODE_ENV=development            # production desliga a injeção de falhas (failpoints) incondicionalmente
PORT=3000                       # 0 = porta efêmera
LOG_LEVEL=info                  # debug | info | warn | error (logs JSON estruturados)
INSTANCE_ID=                    # padrão: hostname-pid (usado como "locked_by" dos leases da outbox)

# ---- PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wager
DB_POOL_MIN=1
DB_POOL_MAX=20
DB_ACQUIRE_TIMEOUT_MS=10000     # espera por conexão do pool (excedido ⇒ erro transitório ⇒ 503)
DB_LOCK_TIMEOUT_MS=5000         # espera máxima pelo lock de uma wallet (excedido ⇒ erro transitório ⇒ retry/503)
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TX_TIMEOUT_MS=30000
AUTO_MIGRATE=false              # true: aplica migrations no boot (dev). Em produção use `bun run migration:up`

# ---- SQS (LocalStack/MiniStack/moto em dev; AWS real em produção, sem SQS_ENDPOINT)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_AUTO_CREATE=true            # em produção, false (as filas vêm de IaC)
SQS_REDRIVE_MAX_RECEIVE_COUNT=10 # rede de segurança do broker (≥ CONSUMER_MAX_ATTEMPTS)
SQS_VISIBILITY_TIMEOUT_S=60

# ---- Papéis (cada processo pode rodar tudo ou só uma parte)
RUN_HTTP=true
RUN_CONSUMER=true
RUN_OUTBOX_PUBLISHER=true
RUN_PENDING_REFERENCE_WORKER=true

# ---- Consumidor SQS
CONSUMER_WAIT_TIME_S=20         # long polling
CONSUMER_CONCURRENCY=4          # loops de polling concorrentes (cada um recebe até 10 mensagens)
CONSUMER_MAX_ATTEMPTS=5         # tentativas da aplicação antes da DLQ
CONSUMER_BACKOFF_BASE_S=2       # backoff exponencial via ChangeMessageVisibility: base*2^(n-1), teto abaixo
CONSUMER_BACKOFF_MAX_S=300
CONSUMER_SHUTDOWN_TIMEOUT_MS=25000

# ---- Outbox
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000           # se o publisher morrer, outra instância assume após o lease

# ---- Referências fora de ordem (PENDING_REFERENCE)
PENDING_POLL_INTERVAL_MS=1000
PENDING_BATCH_SIZE=50
PENDING_MAX_ATTEMPTS=10         # limite de tentativas (backoff exponencial)
PENDING_TTL_MS=300000           # TTL total (5 min); o primeiro limite atingido rejeita com REFERENCE_NOT_FOUND
PENDING_BASE_DELAY_MS=1000
PENDING_MAX_DELAY_MS=60000

# ---- Testes de caos (ignorado em NODE_ENV=production)
ENABLE_FAILPOINTS=false
FAILPOINTS=                     # ex.: consumer.after-commit:kill,outbox.after-publish:kill,submit.before-commit:throw
