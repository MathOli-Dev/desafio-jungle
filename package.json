{
  "name": "wager-ledger-service",
  "version": "1.0.0",
  "private": true,
  "description": "Serviço financeiro distribuído para transações de apostas (ledger, idempotência persistente, inbox/outbox, SQS)",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:status": "bun scripts/migrate.ts status",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test --timeout 30000 test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency",
    "test:all": "bun test --timeout 180000 test/unit test/integration test/concurrency",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "5.0.6",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
